{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allnewmts:schema:verification-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "canonicalOwners", "checks", "suites", "integrity"],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "schemaVersion": { "const": 2 },
    "canonicalOwners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/canonicalOwner" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "suites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "ci"],
      "properties": {
        "fast": { "$ref": "#/$defs/suite" },
        "ci": { "$ref": "#/$defs/suite" }
      }
    },
    "integrity": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/integrity" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?($|/))(?!.*\\\\).+$"
    },
    "canonicalOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "path", "heading"],
      "properties": {
        "topic": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "path": { "$ref": "#/$defs/relativePath" },
        "heading": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packageScript", "command", "argv", "inputs", "outputs", "budgetSeconds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "packageScript": { "type": "string", "pattern": "^verify:[a-z][a-z0-9-]*$" },
        "command": { "type": "string", "pattern": "^npm run verify:" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "budgetSeconds": { "type": "number", "minimum": 1 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "budgetSeconds"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "budgetSeconds": { "type": "number", "minimum": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
