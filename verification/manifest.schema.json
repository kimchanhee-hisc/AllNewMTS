{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allnewmts:schema:verification-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "canonicalOwners",
    "focusedChecks",
    "stories",
    "tiers",
    "layers",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "canonicalOwners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "path",
          "heading"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?($|/))[^/]+(?:/[^/]+)*$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "focusedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "packageScript",
          "command",
          "argv",
          "owner",
          "activation",
          "risk",
          "inputs",
          "outputs",
          "budgetSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "packageScript": {
            "type": "string",
            "pattern": "^verify:"
          },
          "command": {
            "type": "string",
            "pattern": "^npm run verify:"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "activation": {
            "enum": [
              "active",
              "deferred"
            ]
          },
          "risk": {
            "enum": [
              "static",
              "contract",
              "type",
              "unit",
              "fixture",
              "native",
              "runtime",
              "ui",
              "package",
              "provenance"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "budgetSeconds": {
            "type": "number",
            "minimum": 1
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "activation",
          "checks",
          "budgetSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G[0-9A-Z]+-"
          },
          "activation": {
            "enum": [
              "active",
              "deferred"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "budgetSeconds": {
            "type": "number",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "activation"
              ],
              "properties": {
                "activation": {
                  "const": "active"
                }
              }
            },
            "then": {
              "properties": {
                "checks": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "story",
        "milestone",
        "ci"
      ],
      "properties": {
        "fast": {
          "$ref": "#/$defs/tier"
        },
        "story": {
          "$ref": "#/$defs/tier"
        },
        "milestone": {
          "$ref": "#/$defs/tier"
        },
        "ci": {
          "$ref": "#/$defs/tier"
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "owner",
          "requiredForMilestone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "status": {
            "enum": [
              "active",
              "deferred"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "requiredForMilestone": {
            "type": "boolean"
          }
        }
      }
    },
    "integrity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?($|/))[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "checks",
        "budgetSeconds",
        "readinessClaim"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budgetSeconds": {
          "type": "number",
          "minimum": 1
        },
        "readinessClaim": {
          "enum": [
            "diagnostic-only",
            "story",
            "milestone"
          ]
        }
      }
    }
  }
}
