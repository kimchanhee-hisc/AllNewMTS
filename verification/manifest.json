      "outputs": [
        "five targeted phase diagnostics and independent contract/policy evidence",
        "module parity and bounded Development Build composition evidence",
        "read-only exact Pod cache preflight and runner-owned local artifact evidence",
        "PID-scoped sampled network and owned cleanup evidence"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "package",
      "packageScript": "verify:package",
      "command": "npm run verify:package",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "deferred",
        "package"
      ],
      "owner": "G006-verify-first-milestone",
      "activation": "deferred",
      "risk": "package",
      "inputs": [
        "future local package artifacts"
      ],
      "outputs": [
        "DEFERRED(G006-verify-first-milestone)"
      ],
      "budgetSeconds": 30
    }
