        "node",
        "scripts/verify-runtime.mjs"
      ],
      "owner": "G003-implement-bounded-native-runtime",
      "activation": "active",
      "risk": "runtime",
      "inputs": [
        "active Host API ledger and runtime-result schema",
        "shared production runtime and manifest Lua resources",
        "iOS and Android mechanics adapters",
        "hostile runtime and narrow G002 smoke fixtures"
      ],
      "outputs": [
        "contract/core/limits/lifecycle/token/isolation/adapter parity evidence",
        "focused PASS without UI, network, upstream adoption, or story aggregation"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "provenance",
