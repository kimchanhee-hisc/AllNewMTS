        "node",
        "scripts/verify-foundation.mjs",
        "docs"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "contract",
      "inputs": [
        "AGENTS.md",
        "docs",
        "contracts",
        "verification/manifest.json"
      ],
      "outputs": [
        "schema, link, command, and drift diagnostics"
