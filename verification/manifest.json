        "node",
        "scripts/verify-foundation.mjs",
        "provenance"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "provenance",
      "inputs": [
        "test/oracles/manifest.json",
        "frozen sources and goldens"
      ],
      "outputs": [
        "local inventory and hash diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "ui",
      "packageScript": "verify:ui",
      "command": "npm run verify:ui",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "deferred",
        "ui"
