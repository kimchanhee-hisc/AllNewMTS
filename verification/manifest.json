{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 2,
  "canonicalOwners": [
    {
      "topic": "product-and-input-scope",
      "path": "docs/specs/xmf-lua-runtime.md",
      "heading": "# XMF/Lua runtime product contract"
    },
    {
      "topic": "image-control-semantics",
      "path": "docs/specs/controls/image.md",
      "heading": "# Image control contract"
    },
    {
      "topic": "host-and-runtime-semantics",
      "path": "docs/specs/runtime-contract.md",
      "heading": "# Shared runtime contract"
    },
    {
      "topic": "networking-contract-and-evidence",
      "path": "docs/specs/networking-contract.md",
      "heading": "# Networking contract and evidence"
    },
    {
      "topic": "verification-and-evidence",
      "path": "docs/testing.md",
      "heading": "# Verification and evidence contract"
    },
    {
      "topic": "interpreter-decision",
      "path": "docs/adr/0001-official-lua-5.1.5.md",
      "heading": "# ADR 0001: Embed official Lua 5.1.5"
    }
  ],
  "checks": [
    {
      "id": "format",
      "packageScript": "verify:format",
      "command": "npm run verify:format",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "format"
      ],
      "inputs": [
        "tracked text and JSON"
      ],
      "outputs": [
        "format diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "docs",
      "packageScript": "verify:docs",
      "command": "npm run verify:docs",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "docs"
      ],
      "inputs": [
        "AGENTS.md",
        "docs",
        "contracts",
        "verification/manifest.json"
      ],
      "outputs": [
        "schema, link, command, and drift diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "policy",
      "packageScript": "verify:policy",
      "command": "npm run verify:policy",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "policy"
      ],
      "inputs": [
        "tracked production sources",
        "package.json",
        "machine contracts"
      ],
      "outputs": [
        "objective policy diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "type",
      "packageScript": "verify:type",
      "command": "npm run verify:type",
      "argv": [
        "tsc",
        "--noEmit"
      ],
      "inputs": [
        "TypeScript sources",
        "tsconfig.json"
      ],
      "outputs": [
        "TypeScript diagnostics"
      ],
      "budgetSeconds": 60
    },
    {
      "id": "unit",
      "packageScript": "verify:unit",
      "command": "npm run verify:unit",
      "argv": [
        "node",
        "--test",
        "test/foundation.test.mjs"
      ],
      "inputs": [
        "scripts/verify-foundation.mjs",
        "contracts and schemas",
        "verification/manifest.json"
      ],
      "outputs": [
        "TAP"
      ],
      "budgetSeconds": 120
    },
    {
      "id": "development-runners",
      "packageScript": "verify:development-runners",
      "command": "npm run verify:development-runners",
      "argv": [
        "node",
        "--test",
        "test/development-runners.test.mjs"
      ],
      "inputs": [
        "optional Development Build runners",
        "local dependency installation"
      ],
      "outputs": [
        "TAP"
      ],
      "budgetSeconds": 180
    },
    {
      "id": "fixtures",
      "packageScript": "verify:fixtures",
      "command": "npm run verify:fixtures",
      "argv": [
        "node",
        "scripts/verify-fixtures.mjs"
      ],
      "inputs": [
        "test/oracles/manifest.json",
        "frozen sources and goldens"
      ],
      "outputs": [
        "oracle and generator diagnostics"
      ],
      "budgetSeconds": 300
    },
    {
      "id": "native",
      "packageScript": "verify:native",
      "command": "npm run verify:native",
      "argv": [
        "node",
        "scripts/verify-native.mjs"
      ],
      "inputs": [
        "official Lua archive and source inventory",
        "native harness",
        "iOS and Android adapters"
      ],
      "outputs": [
        "source, build, sandbox, resource, and symbol evidence"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "runtime",
      "packageScript": "verify:runtime",
      "command": "npm run verify:runtime",
      "argv": [
        "node",
        "scripts/verify-runtime.mjs"
      ],
      "inputs": [
        "Host API ledger",
        "runtime result schema",
        "production runtime",
        "platform adapters"
      ],
      "outputs": [
        "runtime contract, lifecycle, limits, isolation, and parity evidence"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "ui",
      "packageScript": "verify:ui",
      "command": "npm run verify:ui",
      "argv": [
        "node",
        "scripts/verify-ui.mjs"
      ],
      "inputs": [
        "approved and synthetic XMF",
        "parser and renderer",
        "runtime client",
        "local native caches"
      ],
      "outputs": [
        "parser, projection, client, and module evidence"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "ctlimage",
      "packageScript": "verify:ctlimage",
      "command": "npm run verify:ctlimage",
      "argv": [
        "node",
        "scripts/verify-ui.mjs",
        "--phase",
        "ctlimage"
      ],
      "inputs": [
        "docs/specs/controls/image.md, XMF Image grammar, and control registry",
        "Image model, runtime projection, and renderer",
        "caller-supplied target-partitioned provider map"
      ],
      "outputs": [
        "Image runtime and resource-boundary evidence"
      ],
      "budgetSeconds": 120
    },
    {
      "id": "control-modules",
      "packageScript": "verify:control-modules",
      "command": "npm run verify:control-modules",
      "argv": [
        "node",
        "scripts/verify-ui.mjs",
        "--phase",
        "control-modules"
      ],
      "inputs": [
        "control registry",
        "explicit control modules",
        "React Native component boundary"
      ],
      "outputs": [
        "control dispatch and projection evidence"
      ],
      "budgetSeconds": 120
    },
    {
      "id": "provenance",
      "packageScript": "verify:provenance",
      "command": "npm run verify:provenance",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "provenance"
      ],
      "inputs": [
        "test/oracles/manifest.json",
        "frozen sources and goldens"
      ],
      "outputs": [
        "local inventory and hash diagnostics"
      ],
      "budgetSeconds": 30
    }
  ],
  "suites": {
    "fast": {
      "checks": [
        "format",
        "docs",
        "policy",
        "type",
        "unit"
      ],
      "budgetSeconds": 300
    },
    "ci": {
      "checks": [
        "format",
        "docs",
        "policy",
        "type",
        "unit",
        "fixtures",
        "native",
        "runtime",
        "ui"
      ],
      "budgetSeconds": 3600
    }
  },
