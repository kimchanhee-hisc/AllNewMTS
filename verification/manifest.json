      "owner": "G004-build-generic-xmf-ui-path",
      "activation": "deferred",
      "risk": "ui",
      "inputs": [
        "future shared renderer"
      ],
      "outputs": [
        "DEFERRED(G004-build-generic-xmf-ui-path)"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "package",
      "packageScript": "verify:package",
      "command": "npm run verify:package",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "deferred",
        "package"
      ],
      "owner": "G006-verify-first-milestone",
      "activation": "deferred",
      "risk": "package",
      "inputs": [
        "future local package artifacts"
      ],
      "outputs": [
        "DEFERRED(G006-verify-first-milestone)"
      ],
      "budgetSeconds": 30
    }
  ],
