  "focusedChecks": [
    {
      "id": "format",
      "packageScript": "verify:format",
      "command": "npm run verify:format",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "format"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "static",
      "inputs": [
        "tracked text and JSON"
      ],
      "outputs": [
        "format diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "docs",
      "packageScript": "verify:docs",
      "command": "npm run verify:docs",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "docs"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "contract",
      "inputs": [
        "AGENTS.md",
        "docs",
        "contracts",
        "verification/manifest.json"
      ],
      "outputs": [
        "schema, link, command, and drift diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "policy",
      "packageScript": "verify:policy",
      "command": "npm run verify:policy",
      "argv": [
        "node",
        "scripts/verify-foundation.mjs",
        "policy"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "static",
      "inputs": [
        "tracked production sources",
        "package.json",
        "machine contracts"
      ],
      "outputs": [
        "objective policy diagnostics"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "type",
      "packageScript": "verify:type",
      "command": "npm run verify:type",
      "argv": [
        "tsc",
        "--noEmit"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "type",
      "inputs": [
        "TypeScript sources",
        "tsconfig.json"
      ],
      "outputs": [
        "TypeScript diagnostics"
      ],
      "budgetSeconds": 60
    },
    {
      "id": "unit",
      "packageScript": "verify:unit",
      "command": "npm run verify:unit",
      "argv": [
        "node",
        "--test",
        "test/foundation.test.mjs"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "unit",
      "inputs": [
        "scripts/verify-foundation.mjs",
        "verification/manifest.json"
      ],
      "outputs": [
        "TAP"
      ],
      "budgetSeconds": 30
    },
    {
      "id": "fixtures",
      "packageScript": "verify:fixtures",
      "command": "npm run verify:fixtures",
      "argv": [
        "node",
        "scripts/verify-g001.mjs"
      ],
      "owner": "G001A-establish-ai-native-foundation",
      "activation": "active",
      "risk": "fixture",
      "inputs": [
        "test/oracles/manifest.json",
        "frozen sources and goldens"
      ],
      "outputs": [
        "oracle and generator diagnostics"
      ],
      "budgetSeconds": 300
    },
    {
      "id": "native",
      "packageScript": "verify:native",
      "command": "npm run verify:native",
      "argv": [
        "node",
        "scripts/verify-native.mjs"
      ],
      "owner": "G002-embed-official-lua-5-1-5",
      "activation": "active",
      "risk": "native",
      "inputs": [
        "official Lua archive and zero-diff source inventory",
        "shared native harness",
        "iOS and Android mechanics adapters",
        "one shared adapter fixture/golden"
      ],
      "outputs": [
        "source/build/sandbox/resource/symbol evidence",
        "PASS or explicit unavailable-runtime BLOCKED evidence"
      ],
      "budgetSeconds": 1.2e3
    },
    {
      "id": "provenance",
      "packageScript": "verify:provenance",
