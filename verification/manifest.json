      "activation": "active",
      "risk": "fixture",
      "inputs": [
        "test/oracles/manifest.json",
        "frozen sources and goldens"
      ],
      "outputs": [
        "oracle and generator diagnostics"
      ],
      "budgetSeconds": 300
    },
    {
      "id": "native",
      "packageScript": "verify:native",
      "command": "npm run verify:native",
      "argv": [
        "node",
        "scripts/verify-native.mjs"
      ],
      "owner": "G002-embed-official-lua-5-1-5",
      "activation": "active",
      "risk": "native",
      "inputs": [
        "official Lua archive and zero-diff source inventory",
        "shared native harness",
        "iOS and Android mechanics adapters",
        "one shared adapter fixture/golden"
      ],
      "outputs": [
        "source/build/sandbox/resource/symbol evidence",
        "PASS or explicit unavailable-runtime BLOCKED evidence"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "runtime",
      "packageScript": "verify:runtime",
      "command": "npm run verify:runtime",
      "argv": [
        "node",
        "scripts/verify-runtime.mjs"
      ],
      "owner": "G003-implement-bounded-native-runtime",
      "activation": "active",
      "risk": "runtime",
      "inputs": [
        "active Host API ledger and runtime-result schema",
        "shared production runtime and manifest Lua resources",
        "iOS and Android mechanics adapters",
        "hostile runtime and narrow G002 smoke fixtures"
      ],
      "outputs": [
        "contract/core/limits/lifecycle/token/isolation/adapter parity evidence",
        "focused PASS without UI, network, upstream adoption, or story aggregation"
      ],
      "budgetSeconds": 1200
    },
    {
      "id": "provenance",
