    {
      "id": "ui",
      "packageScript": "verify:ui",
      "command": "npm run verify:ui",
      "argv": [
        "node",
        "scripts/verify-ui.mjs"
      ],
      "owner": "G004-build-generic-xmf-ui-path",
      "activation": "active",
      "risk": "ui",
      "inputs": [
        "approved original, frozen synthetic, and temporary unseen XMF bytes",
        "closed XMF grammar and control registry policies",
        "generic parser, renderer, runtime client, App composition, and generated asset",
        "production Swift/Kotlin module bodies through verification-only stubs",
        "exact-version cached React Native dependency and Hermes V1 artifacts",
        "one offline iOS simulator Development Build"
