				</TRBLOCK>
			</TRAN>
			<TRAN name="SYN90011" title="관심그룹_순서변경/그룹명변경/삭제/조회" realdata="0" dessvr="M" occurslen="0" memfieldlen="0" >
				<TRBLOCK name="InBlock1" inout="in" _len="121" _ulen="97" >
usid^회원 ID^10^0^0^0^0^0^0^10^
