<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="1200" scrname="관심종목_그룹추가" version="3" writer="조승희" scrtype="1" scripttype="1" />
	<FORM_INFO name="Form" bgcolor="206:255255255" ly_vert="0,0,360,216,1" />
	<CONTROL_INFO>
		<LABEL name="lbl0" caption="관심그룹 추가" fontsize="4" fontstyle="01" ly_vert="18,0,324,26,1" />
		<LABEL name="lbl1" caption="추가할 그룹명을 입력해 주세요." ly_vert="18,42,324,20,1" />
		<EDIT name="edtGroupNm" hintcaption="그룹 이름 (최대 10자리)" imetype="0" maxlength="10" leadheight="0" paddinginfo="12,0,12,0" ly_vert="18,68,324,40,1" />
		<BUTTON name="btnAdd" enable="0" caption="추가" fgcolor="010:255255255" fontsize="2" ly_vert="185,142,157,56,1" />
		<BUTTON name="btnCancel" caption="취소" fgcolor="103:111111111" bgcolor="136:227227227" fontsize="2" bordersize="0" ly_vert="18,142,157,56,1" />
		<TABORDER_INFO horz="btnAdd`btnCancel" vert="btnAdd`btnCancel" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6711" _ulen="6441" >
--===========================================================================
-- 화  면  명 : 관심종목_그룹추가
-- 화  면  ID : 
-- 개      요 : 
-- 작      성 : 2024.09.24 조승희
-- 수      정 : 
--===========================================================================
dofile("scr/script.lua")
local json = dofile("scr/json.lua")

local g_bOnlyClose = true
local g_szReceiveData = ""
--============================================================================
function Form_OnFormInit()
	btnAdd.border = "1" -- 활성화 상태의 버튼에 외곽선이 있는 스타일일 경우에만 추가
    btnAdd.dfgcolor = "101"
	btnAdd.SetRadius(12, "138", "139", "131", false, "166", "166", "131", 1)
	
	g_szReceiveData = Form.GetOpenLinkData()
end

--============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "OnlyShow" then
	    if sRet == "confirm" then
	        DATAMANAGER.RequestTranData( "CCS20000" )
	    end
	end
end

--============================================================================
function Form_OnFormClose()
	if g_bOnlyClose then
	    Form.SendReturnToParent( "AddNewGroup" ,  "NoChange",  true)
	end
end

--============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
    local szUserId = Form.GetSharedData("&USER_ID", false)
    
	if szTranID == "CCS20001" then
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "usid" , 0 , szUserId )
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "wk_tp" , 0 , "1" ) -- 관심그룹 신규 등록
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "arr_cnt" , 0 , "1" )
	    
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "grpnum" , 0 , "" ) -- 관심그룹 신규 등록 시 공백으로 넣기
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "grpname" , 0 , edtGroupNm.caption )
	    
	elseif szTranID == "CCS20000" then    
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "usid" , 0 , szUserId )
	    DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "wk_tp" , 0 , "1" ) 
    end
end

--============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID == "CCS20001" then
        if g_szReceiveData == "Now" then
            g_bOnlyClose = false
            
            Form.SendReturnToParent( "AddNewGroup" ,  "",  true)
        else
            local nDataCnt = gf_Tonumber(DATAMANAGER.GetDataCount( false, szTranID , "OutBlock2" ))
            local szNewGrpNum = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "grpnum" , nDataCnt - 1  )
            local szNewGrpName = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "grpname" , nDataCnt - 1  )
            
            DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock1" , "grpnum" , 0 , szNewGrpNum )
            DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock1" , "grpname" , 0 , szNewGrpName )
            
            local tParseData = json.parse(g_szReceiveData, 1, string.len(g_szReceiveData))
            
            DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock1" , "arr_cnt" , 0 , #tParseData )
	        
	        local nProductCnt = #tParseData
	        if nProductCnt > 100 then
	            nProductCnt = 100
	        end
	        
	        for i = 1, nProductCnt do
	            local szCode = tParseData[i]["Code"]
	            local szMarketText = Form.GetItemCodeInfo(szCode,  "markettext", tParseData[i]["MarketLink"])
--szMarketText = szMarketText == "Q" and "J" or szMarketText
	            
	            DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "shrn_iscd" , i - 1 , szCode )
                DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "mrkt_div_cls_code" , i - 1 , szMarketText == "Q" and "J" or szMarketText )
                DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "ldate" , i - 1 , "" )
                DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "color" , i - 1 , "" )
                
                -- 해외일 때만 거래소코드 넣기
                if szMarketText == "OY" or szMarketText == "OV" then
                    local szExchangeCode = Form.GetItemCodeInfo(szCode,  "exchangecode")
                    DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "exch_cls_code" , i - 1 , szExchangeCode )
                elseif szMarketText == "CR" then -- 크립토 예외처리
                    local szExchangeCode = Form.GetItemCodeInfo(szCode,  "exchangecode", tParseData[i]["MarketLink"])
                    DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "exch_cls_code" , i - 1 , szExchangeCode )
                else
                    DATAMANAGER.SetDataValue( false, "CCS20000" , "InBlock2" , "exch_cls_code" , i - 1 , "" )
                end
	        end
            
            if #tParseData > 100 then
                Form.MsgBoxEx("", "관심그룹에 종목은 최대 100개까지 추가할 수 있어요.\n100개가 넘어가는 종목은 제외하고 추가할게요.", "OnlyShow", "", "확인", 0)
            else
                DATAMANAGER.RequestTranData( "CCS20000" )
            end
        end
        
    elseif szTranID == "CCS20000" then 
        g_bOnlyClose = false
        
        Form.Toast(0,  "["..edtGroupNm.caption.."]에 추가했어요.",  1)
        Form.SendReturnToParent("FinishAddProduct" ,  edtGroupNm.caption,  true)
    end
end

--============================================================================
function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    gf_ShowErrorPopup(szTranID, szErrCode, szErrMsg)
end

--============================================================================
function edtGroupNm_OnEditComplete()
	if gf_Trim(edtGroupNm.caption) ~= nil and gf_Trim(edtGroupNm.caption) ~= "" then
	    btnAdd.enable = true
	else
        btnAdd.enable = false
	end
end
 
--============================================================================
function btnAdd_OnClick()
    if g_szReceiveData ~= nil and g_szReceiveData ~= "" then
        DATAMANAGER.RequestTranData( "CCS20001" )
	else
	    g_bOnlyClose = false
	    Form.SendReturnToParent( "AddNewGroup" ,  edtGroupNm.caption,  true)
    end
end

--============================================================================
function btnCancel_OnClick()
	Form.CloseForm()
end

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="CCS20000" trcode="CCS20000" encryption="1" useattr="0" />
			<TRAN tranid="CCS20001" trcode="CCS20001" encryption="1" useattr="0" />
