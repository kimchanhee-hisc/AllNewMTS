{
  "name": "allnewmts-workspace",
  "version": "1.0.0",
  "workspaces": [
    "apps/allnewmts",
    "apps/labs/*",
    "modules/*",
    "packages/*"
  ],
  "dependencies": {
    "expo": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "patch:expo-modules-core": "node scripts/patch-expo-modules-core.mjs",
    "postinstall": "node scripts/patch-expo-modules-core.mjs",
    "preios": "node scripts/patch-expo-modules-core.mjs",
    "preverify:ui": "node scripts/patch-expo-modules-core.mjs",
    "verify:format": "node scripts/verify-foundation.mjs format",
    "verify:docs": "node scripts/verify-foundation.mjs docs",
    "verify:policy": "node scripts/verify-foundation.mjs policy",
    "verify:type": "tsc --noEmit",
    "verify:unit": "node --test test/foundation.test.mjs",
    "verify:development-runners": "node --test test/development-runners.test.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:networking": "node scripts/verify-networking.mjs",
    "mci:probe:beta": "node scripts/probe-mci-beta.mjs",
    "mci:probe:beta:realtime": "node scripts/probe-mci-beta-realtime.mjs",
    "mci:probe:beta:tr": "node scripts/probe-mci-beta-tr.mjs",
    "rest:probe:beta:tr": "swift scripts/probe-rest-beta-tr.swift",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:provenance": "node scripts/verify-foundation.mjs provenance",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:ctlimage": "node scripts/verify-ui.mjs --phase ctlimage",
    "verify:control-modules": "node scripts/verify-ui.mjs --phase control-modules",
    "verify:layers": "node scripts/verify-layers.mjs",
    "verify:fast": "node scripts/verify-foundation.mjs fast",
    "verify:ci": "node scripts/verify-foundation.mjs ci",
    "app:allnewmts:ios": "npm run ios --workspace @allnewmts/app",
    "app:allnewmts:android": "npm run android --workspace @allnewmts/app",
    "lab:xmf": "node scripts/run-xmf-lab.mjs",
    "lab:networking": "node scripts/run-networking-lab.mjs",
    "lab:xmf:smoke": "node scripts/run-ui-development-build.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "private": true
}
