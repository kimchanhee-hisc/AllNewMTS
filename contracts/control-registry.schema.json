{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allnewmts:schema:control-registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "owningGoal", "inputRoles", "controls"],
  "properties": {
    "$schema": { "const": "./control-registry.schema.json" },
    "schemaVersion": { "const": 1 },
    "owningGoal": { "type": "string", "minLength": 1 },
    "inputRoles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "decision", "role", "diagnostic"],
        "properties": {
          "name": { "enum": ["XMF", "XMS"] },
          "decision": { "enum": ["include", "exclude", "defer"] },
          "role": { "type": "string", "minLength": 1 },
          "diagnostic": { "type": ["string", "null"] }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "sourceTags", "semanticFamilies", "normalizedType", "properties", "mutableProperties", "events", "capabilities", "fallback", "diagnostic"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "decision": { "enum": ["include", "exclude", "defer"] },
          "sourceTags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "semanticFamilies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "normalizedType": { "type": "string", "minLength": 1 },
          "properties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "mutableProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "events": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "fallback": { "type": "string", "minLength": 1 },
          "diagnostic": { "type": ["string", "null"] }
        }
      }
    }
  }
}
