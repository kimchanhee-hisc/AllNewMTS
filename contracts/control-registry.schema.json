{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allnewmts:schema:control-registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "owningGoal", "inputRoles", "form", "controls", "policies"],
  "properties": {
    "$schema": { "const": "./control-registry.schema.json" },
    "schemaVersion": { "const": 1 },
    "owningGoal": { "const": "G004-build-generic-xmf-ui-path" },
    "inputRoles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/inputRole" }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties"],
      "properties": { "properties": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/property" } } }
    },
    "controls": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/control" }
    },
    "policies": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "inputRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decision", "role", "diagnostic"],
      "properties": {
        "name": { "enum": ["XMF", "XMS"] },
        "decision": { "enum": ["include", "defer"] },
        "role": { "enum": ["screen-form-document", "unestablished"] },
        "diagnostic": { "enum": [null, "UNSUPPORTED_INPUT_ROLE"] }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "policy", "required", "default", "maxBytes"],
      "properties": {
        "name": { "enum": ["name", "caption", "hintcaption", "imetype", "maxlength", "leadheight", "paddinginfo", "ly_vert", "enable", "fgcolor", "bgcolor", "fontsize", "fontstyle", "bordersize"] },
        "policy": { "enum": ["identifier", "text", "layout", "enabled", "max-length", "padding", "input-mode", "lead-height", "encoded-color", "border-size", "font-size", "font-style"] },
        "required": { "type": "boolean" },
        "default": { "enum": [null, "empty-string", "enabled", "native-default", "zero", "omit"] },
        "maxBytes": { "enum": [1, 2, 3, 6, 13, 19, 21, 128, 2048] }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "handlerSuffix", "controlMutations"],
      "properties": {
        "name": { "enum": ["OnEditComplete", "OnClick"] },
        "handlerSuffix": { "enum": ["_OnEditComplete", "_OnClick"] },
        "controlMutations": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["property", "valueSource"],
            "properties": {
              "property": { "const": "caption" },
              "valueSource": { "const": "value" }
            }
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "sourceTags", "semanticFamilies", "normalizedType", "properties", "mutableProperties", "events", "capabilities", "undeclared", "diagnostic"],
      "properties": {
        "id": { "enum": ["label", "edit", "button", "image"] },
        "decision": { "enum": ["include", "defer"] },
        "sourceTags": { "type": "array", "items": { "enum": ["LABEL", "EDIT", "BUTTON"] }, "uniqueItems": true },
        "semanticFamilies": { "type": "array", "items": { "enum": ["CtlButton", "CtlImage"] }, "uniqueItems": true },
        "normalizedType": { "enum": ["Label", "Edit", "Button", "unsupported"] },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "mutableProperties": { "type": "array", "items": { "enum": ["caption", "border", "dfgcolor", "enable"] }, "uniqueItems": true },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "enum": ["text", "layout", "accessibility-label", "text-input", "focus", "press", "enabled-state", "SetRadius", "accessibility-button"] }, "uniqueItems": true },
        "undeclared": { "const": "reject" },
        "diagnostic": { "enum": [null, "UNSUPPORTED_CONTROL_TYPE"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coercion", "projection", "unsupported", "warning"],
      "properties": {
        "id": { "enum": ["identifier", "text", "layout", "enabled", "max-length", "padding", "input-mode", "lead-height", "encoded-color", "border-size", "font-size", "font-style", "runtime-border", "runtime-disabled-color"] },
        "coercion": { "enum": ["identifier", "bounded-text", "layout-rect", "zero-one-boolean", "canonical-decimal-1-262144", "padding-quad-0-1024", "exact-zero", "encoded-rgb", "canonical-decimal-0-255", "ascii-digits-1-3", "two-bits", "runtime-border-token", "runtime-color-token"] },
        "projection": { "enum": ["data", "logical-pixels", "enabled", "max-length", "native-default", "rgb", "omit", "rgb-or-token"] },
        "unsupported": { "enum": ["reject", "omit-with-warning"] },
        "warning": { "enum": [null, "UNSUPPORTED_PRESENTATION_CODE"] }
      }
    }
  }
}
