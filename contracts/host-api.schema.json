{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allnewmts:schema:host-api",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contract", "inventoryStatus", "owningGoal", "publicApis", "compatibilityDecisions"],
  "properties": {
    "$schema": { "const": "./host-api.schema.json" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cross-platform-host" },
    "inventoryStatus": { "enum": ["active", "deferred"] },
    "owningGoal": { "type": "string", "minLength": 1 },
    "publicApis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "returns", "effects", "evidence", "test"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$" },
          "signature": { "type": "string", "minLength": 1 },
          "returns": { "type": "string", "minLength": 1 },
          "effects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "test": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibilityDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "evidence", "rationale", "affectedPlatforms", "resolution", "testOrGolden"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "decision": { "enum": ["include", "exclude", "defer"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 },
          "affectedPlatforms": { "type": "array", "minItems": 1, "items": { "enum": ["ios", "android", "shared"] }, "uniqueItems": true },
          "resolution": { "enum": ["normalize", "safe-union", "reject", "defer"] },
          "testOrGolden": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
