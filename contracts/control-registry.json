{
  "$schema": "./control-registry.schema.json",
  "schemaVersion": 1,
  "inputRoles": [
    {
      "name": "XMF",
      "decision": "include",
      "role": "screen-form-document",
      "diagnostic": null
    },
    {
      "name": "XMS",
      "decision": "unsupported",
      "role": "unestablished",
      "diagnostic": "UNSUPPORTED_INPUT_ROLE"
    }
  ],
  "form": {
    "properties": [
      { "name": "name", "policy": "identifier", "required": true, "default": null, "maxBytes": 128 },
      { "name": "bgcolor", "policy": "encoded-color", "required": true, "default": null, "maxBytes": 13 },
      { "name": "ly_vert", "policy": "layout", "required": true, "default": null, "maxBytes": 21 }
    ]
  },
  "controls": [
    {
      "id": "label",
      "decision": "include",
      "sourceTags": ["LABEL"],
      "semanticFamilies": [],
      "normalizedType": "Label",
      "properties": [
        { "name": "name", "policy": "identifier", "required": true, "default": null, "maxBytes": 128 },
        { "name": "caption", "policy": "text", "required": true, "default": null, "maxBytes": 2048 },
        { "name": "fontsize", "policy": "font-size", "required": false, "default": "omit", "maxBytes": 3 },
        { "name": "fontstyle", "policy": "font-style", "required": false, "default": "omit", "maxBytes": 2 },
        { "name": "ly_vert", "policy": "layout", "required": true, "default": null, "maxBytes": 21 }
      ],
      "mutableProperties": [],
      "events": [],
      "capabilities": ["text", "layout", "accessibility-label"],
      "undeclared": "reject",
      "diagnostic": null
    },
    {
      "id": "edit",
      "decision": "include",
      "sourceTags": ["EDIT"],
      "semanticFamilies": [],
      "normalizedType": "Edit",
      "properties": [
        { "name": "name", "policy": "identifier", "required": true, "default": null, "maxBytes": 128 },
        { "name": "caption", "policy": "text", "required": false, "default": "empty-string", "maxBytes": 2048 },
        { "name": "hintcaption", "policy": "text", "required": true, "default": null, "maxBytes": 2048 },
        { "name": "imetype", "policy": "input-mode", "required": true, "default": null, "maxBytes": 1 },
        { "name": "maxlength", "policy": "max-length", "required": true, "default": null, "maxBytes": 6 },
        { "name": "leadheight", "policy": "lead-height", "required": true, "default": null, "maxBytes": 1 },
        { "name": "paddinginfo", "policy": "padding", "required": true, "default": null, "maxBytes": 19 },
        { "name": "ly_vert", "policy": "layout", "required": true, "default": null, "maxBytes": 21 }
      ],
      "mutableProperties": ["caption"],
      "events": [
        {
          "name": "OnEditComplete",
          "handlerSuffix": "_OnEditComplete",
          "controlMutations": [{ "property": "caption", "valueSource": "value" }]
        }
      ],
      "capabilities": ["text-input", "layout", "focus", "accessibility-label"],
      "undeclared": "reject",
      "diagnostic": null
    },
    {
      "id": "button",
      "decision": "include",
      "sourceTags": ["BUTTON"],
      "semanticFamilies": ["CtlButton"],
      "normalizedType": "Button",
      "properties": [
        { "name": "name", "policy": "identifier", "required": true, "default": null, "maxBytes": 128 },
        { "name": "caption", "policy": "text", "required": true, "default": null, "maxBytes": 2048 },
        { "name": "enable", "policy": "enabled", "required": false, "default": "enabled", "maxBytes": 1 },
        { "name": "fgcolor", "policy": "encoded-color", "required": true, "default": null, "maxBytes": 13 },
        { "name": "bgcolor", "policy": "encoded-color", "required": false, "default": "native-default", "maxBytes": 13 },
        { "name": "fontsize", "policy": "font-size", "required": true, "default": null, "maxBytes": 3 },
        { "name": "bordersize", "policy": "border-size", "required": false, "default": "zero", "maxBytes": 3 },
        { "name": "ly_vert", "policy": "layout", "required": true, "default": null, "maxBytes": 21 }
      ],
      "mutableProperties": ["border", "dfgcolor", "enable"],
      "events": [
        {
          "name": "OnClick",
          "handlerSuffix": "_OnClick",
          "controlMutations": []
        }
      ],
      "capabilities": ["press", "enabled-state", "SetRadius", "layout", "accessibility-button"],
      "undeclared": "reject",
      "diagnostic": null
    },
    {
      "id": "image",
      "decision": "include",
      "sourceTags": ["IMAGE"],
      "semanticFamilies": ["CtlImage"],
      "normalizedType": "Image",
      "properties": [
        { "name": "name", "policy": "identifier", "required": true, "default": null, "maxBytes": 128 },
        { "name": "imgpath", "policy": "resource-name", "required": true, "default": null, "maxBytes": 256 },
        { "name": "ly_vert", "policy": "layout", "required": true, "default": null, "maxBytes": 21 }
      ],
      "mutableProperties": [],
      "events": [],
      "capabilities": ["image-resource", "layout", "accessibility-image"],
      "undeclared": "reject",
      "diagnostic": null
    }
  ],
  "policies": [
    { "id": "identifier", "coercion": "identifier", "projection": "data", "unsupported": "reject", "warning": null },
    { "id": "text", "coercion": "bounded-text", "projection": "data", "unsupported": "reject", "warning": null },
    { "id": "resource-name", "coercion": "logical-resource-name", "projection": "resolver-key", "unsupported": "reject", "warning": null },
    { "id": "layout", "coercion": "layout-rect", "projection": "logical-pixels", "unsupported": "reject", "warning": null },
    { "id": "enabled", "coercion": "zero-one-boolean", "projection": "enabled", "unsupported": "reject", "warning": null },
    { "id": "max-length", "coercion": "canonical-decimal-1-262144", "projection": "max-length", "unsupported": "reject", "warning": null },
    { "id": "padding", "coercion": "padding-quad-0-1024", "projection": "logical-pixels", "unsupported": "reject", "warning": null },
    { "id": "input-mode", "coercion": "exact-zero", "projection": "native-default", "unsupported": "reject", "warning": null },
    { "id": "lead-height", "coercion": "exact-zero", "projection": "native-default", "unsupported": "reject", "warning": null },
    { "id": "encoded-color", "coercion": "encoded-rgb", "projection": "rgb", "unsupported": "reject", "warning": null },
    { "id": "border-size", "coercion": "canonical-decimal-0-255", "projection": "logical-pixels", "unsupported": "reject", "warning": null },
    { "id": "font-size", "coercion": "ascii-digits-1-3", "projection": "omit", "unsupported": "omit-with-warning", "warning": "UNSUPPORTED_PRESENTATION_CODE" },
    { "id": "font-style", "coercion": "two-bits", "projection": "omit", "unsupported": "omit-with-warning", "warning": "UNSUPPORTED_PRESENTATION_CODE" },
    { "id": "runtime-border", "coercion": "runtime-border-token", "projection": "logical-pixels", "unsupported": "reject", "warning": null },
    { "id": "runtime-disabled-color", "coercion": "runtime-color-token", "projection": "rgb-or-token", "unsupported": "reject", "warning": null }
  ]
}
